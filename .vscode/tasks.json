{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:all",
      "dependsOn": [
        "_dev:backend",
        "_dev:frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "install-and-dev:all",
      "dependsOn": [
        "_install:all",
        "dev:all"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },

    {
      "label": "_install:all",
      "dependsOn": [
        "_install:backend",
        "_install:frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "_install:backend",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}/apps/backend"
      },
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "_install:frontend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/apps/frontend"
      },
      "problemMatcher": [],
      "hide": true
    },

    {
      "label": "_dev:backend",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/apps/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "clear": false
      },
      "hide": true
    },
    {
      "label": "_dev:frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "clear": false
      },
      "detail": "前端使用 Panda CSS。npm run dev 会自动触发 package.json 中的 predev，也就是 npm run panda:gen，生成 styled-system/css 和 styled-system/styles.css。",
      "hide": true
    },

    {
      "label": "_frontend:panda-gen",
      "type": "shell",
      "command": "npm run panda:gen",
      "options": {
        "cwd": "${workspaceFolder}/apps/frontend"
      },
      "problemMatcher": [],
      "detail": "手动补救任务：如果 styled-system 生成物缺失，可以单独运行它。正常 dev:all 不需要手动执行，因为 npm run dev 会自动触发 predev。",
      "hide": true
    }
  ]
}